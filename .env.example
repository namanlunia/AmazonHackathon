# Amazon Continuity Hub Environment Configuration

# Operating mode: 'false' for in-memory store + mock AI (offline), 'true' for AWS DynamoDB + Bedrock
USE_AWS=false

# Target AWS Region
AWS_REGION=us-east-1

# DynamoDB table name for unified user continuity state
DYNAMODB_TABLE=AmazonContinuityState

# Bedrock foundation model ID or cross-region inference profile ID
# For Amazon Nova in us-east-1, use: us.amazon.nova-micro-v1:0
# Alternative: anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MODEL_ID=us.amazon.nova-micro-v1:0

# Hub API Key for authentication (X-API-Key header or api_key query param). Leave blank to disable auth.
HUB_API_KEY=

# Default user ID applied when no X-User-Id header or Alexa user is provided
DEFAULT_USER_ID=default-user

# Allowed CORS origins as a JSON-encoded array of strings.
# To allow the Firefox extension, add "moz-extension://<your-extension-uuid>"
CORS_ORIGINS=["*"]

# Application log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# TTL for user state records in DynamoDB (in days)
STATE_TTL_DAYS=7

# Freshness TTL for active context handoffs in seconds (default: 1800s / 30 mins)
ACTIVE_CONTEXT_MAX_AGE_SECONDS=1800

# Server-side WebSocket heartbeat ping interval in seconds
HEARTBEAT_INTERVAL_SECONDS=20

# Server-side WebSocket heartbeat timeout in seconds (disconnects idle clients)
HEARTBEAT_TIMEOUT_SECONDS=60

# Enforce Amazon ASK signature and X.509 certificate verification on /alexa (false for local demo, true for production)
ALEXA_ENFORCE_SIGNATURE=false
